# Identifiants MinIO (doivent correspondre a ceux utilises par le pipeline et le
# script d'ingestion). Copier ce fichier en ".env" avant `docker compose up`.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Clé API OpenAQ (Partie 3) - gratuite sur https://explore.openaq.org/
# Requise seulement pour le collecteur pollution (profil "pollution").
OPENAQ_API_KEY=
